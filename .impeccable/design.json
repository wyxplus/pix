      "description": "实际按钮变体的样式示例；行为使用项目原组件。",
      "html": "<button class=\"ds-button-primary\">主按钮</button>",
      "css": ".ds-button-primary{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);font-size:var(--text-sm,13px);height:36px;padding:8px 16px;border-radius:var(--radius-lg,10px);font-weight:500;cursor:pointer;transition:background-color 150ms;border:0;background:var(--primary,#1A1C1F);color:var(--primary-foreground,#FAFAFA);}.ds-button-primary:hover{background:color-mix(in srgb,var(--primary,#1A1C1F) 90%,transparent);}.ds-button-primary:focus-visible{outline:2px solid var(--ring,#3A83F7);outline-offset:2px;}.ds-button-primary:disabled{opacity:.5;pointer-events:none;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}",
      "refersTo": "button-primary"
    },
