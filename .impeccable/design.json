  "narrative": {
    "northStar": "克制的 Codex 桌面风格。",
    "overview": "界面以内容、对话和工作区为中心。导航紧凑，设置以平直列表组织，颜色和字重承担层级，浮层材质用于区分前后关系。避免装饰性卡片、突出的品牌标识和导航中的粗重分隔线，延续 `apps/desktop/PRODUCT.md` 的设计方向。",
    "keyCharacteristics": [],
    "rules": [
      {
        "name": "背景模糊规则",
        "body": "只对背后的内容使用 `backdrop-filter`；不得对整个弹层使用 `filter: blur()`。90% 指背景颜色的 alpha，不能给整块菜单设置 `opacity: 0.9` 导致文字、图标一起变淡。",
        "section": "elevation"
      }
    ],
    "dos": [
      "复用语义变量、共用组件和明确的组件例外；需要新的样式时先检查现有角色。",
      "保留默认主题与自定义皮肤、系统字体与自定义字体、明暗模式的独立性。",
      "用背景 alpha 实现半透明，用 backdrop-filter 模糊背后内容，保持文字和图标清晰。",
      "为模型控件保留独立字号和几何参数，为普通菜单复用同一材质。",
      "检查长模型名、provider 分组、无思考支持、禁用态、键盘焦点、窄窗口和大字号。",
      "让设置入口固定在侧栏滚动列表下方，让消息与输入框共用水平边界。",
      "按实际状态区分“已实现”“专用例外”“尚未复刻”，修改实现时同步维护本文件。"
    ],
    "donts": [
      "使用 PRODUCT.md 明确反对的 “decorative cards, prominent branding, and heavy separators in navigation”。",
      "把所有圆角都改成 12px，或把每个表面都套上菜单的玻璃材质。",
      "在普通菜单调用处重新加入不透明底色、旧圆角、重复边框和重阴影覆盖。",
      "让模型选择器、开关、链接和默认焦点分别使用不同的旧蓝色。",
      "给整个菜单设置 90% opacity，或对文字所在内容层使用 blur / 缩放来模拟磨砂。",
      "给确认删除重新加回平移居中或缩放动画，破坏已完成的清晰度修复。",
      "通过更改用户偏好来“修复”字号、缩放、侧栏宽度或皮肤造成的差异。",
      "根据被缩小的截图推断字体模糊原因，或未经同尺度验证就声称与 Codex 像素级完全一致。"
    ]
  }
