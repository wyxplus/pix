{
  "name": "pix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "check:types": "vp check --no-fmt",
    "fmt": "vp check --fix",
    "test": "vp run --no-cache -r test",
    "build": "vp run -r build",
    "dev": "pnpm dev:desktop",
    "dev:desktop": "vp run --no-cache @pix/desktop#dev",
    "build:desktop": "vp run --no-cache @pix/desktop#build",
    "dev:landing": "vp run --no-cache @pix/landing#dev",
    "build:landing": "vp run --no-cache @pix/landing#build",
    "preview:landing": "vp run --no-cache @pix/landing#preview",
    "demo:session-content": "vp run --no-cache @pix/desktop#demo:session-content",
    "e2e": "vp run --no-cache @pix/desktop#e2e",
    "package": "vp run --no-cache @pix/desktop#package",
    "version:set": "node scripts/set-version.mjs",
    "test:release-assets": "node scripts/release-assets.test.mjs",
    "test:release-version": "node --test scripts/next-version.test.mjs scripts/set-version.test.mjs",
    "check:rust": "pnpm --filter @pix/desktop check:rust",
    "test:memory": "pnpm --filter @pix/desktop test:memory",
    "eval:memory": "pnpm --filter @pix/desktop eval:memory",
    "eval:memory:fetch": "pnpm --filter @pix/desktop eval:memory:fetch",
    "eval:memory:report": "pnpm --filter @pix/desktop eval:memory:report",
    "eval:memory:judge": "pnpm --filter @pix/desktop eval:memory:judge",
    "eval:memory:judge-live": "pnpm --filter @pix/desktop eval:memory:judge-live",
    "eval:memory:retrieval": "pnpm --filter @pix/desktop eval:memory:retrieval",
    "eval:memory:acceptance": "pnpm --filter @pix/desktop eval:memory:acceptance",
    "eval:memory:preflight": "pnpm --filter @pix/desktop eval:memory:preflight"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.15.1"
}
